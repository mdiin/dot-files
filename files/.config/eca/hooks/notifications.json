{
  "notify-hooks.finished": {
    "type": "postRequest",
    "visible": false,
    "actions": [
      {
        "type": "shell",
        "shell": "jq -e '.hook_type == \"postRequest\"' > /dev/null && (notify-send 'ECA færdig' 2>/dev/null || true)"
      }
    ]
  },
  "notify-hooks.approval": {
    "type": "preToolCall",
    "visible": false,
    "actions": [
      {
        "type": "shell",
        "shell": "jq -e '.approval == \"ask\"' > /dev/null && (notify-send 'ECA skal høre fra dig!' 2>/dev/null || true)"
      }
    ]
  }
}
