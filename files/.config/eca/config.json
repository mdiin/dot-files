{
    "plugins": {
        "emcli": {
            "source": "https://github.com/mdiin/emcli.git"
        },
        "install": []
    },
    "autoCompactPercentage": 70,
    "providers": {
        "mistral": {
            "api": "openai-chat",
            "url": "https://api.mistral.ai/v1",
            "keyRc": "api.mistral.ai",
            "fetchModels": false,
            "models": {
                "devstral-medium-latest": {"extraPayload": {"max_completion_tokens": null}},
                "ministral-8b-latest": {"extraPayload": {"max_completion_tokens": null}},
                "devstral-small-latest": {"extraPayload": {"max_completion_tokens": null}}
            }
        },
        "ramalama": {
            "api": "openai-chat",
            "url": "http://localhost:9080/v1",
            "completionUrlRelativePath": "/chat/completions",
            "httpClient": { "version": "http-1.1" },
            "fetchModels": false,
            "models": {
                "gemma-4-E2B-it": {
                    "limit": {
                        "context": 32768,
                        "output": 4096
                    }
                },
                "gemma-4-E4B-it": {
                    "limit": {
                        "context": 32768,
                        "output": 4096
                    }
                }
            }
        },
        "deepseek": {
          "api": "openai-chat",
          "url": "https://api.deepseek.com",
          "models": {
            "deepseek-v4-flash": {}
          },
          "key": "sk-4f60000dd0f149aba74fad2523cf5520"
        }
    },
    "defaultModel": "ramalama/gemma-4-E2B-it",
    "$schema": "https://eca.dev/config.json"
}
